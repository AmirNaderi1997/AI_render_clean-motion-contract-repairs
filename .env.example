# Central gateway. The secret stays on the backend; do not use VITE_ variables.
LMAPI_BASE_URL=https://lmapi.rafiei.co/v1
LMAPI_API_KEY=
# Alternative private file. VPS Compose mounts .lmapi_key read-only at /run/secrets/lmapi_key.
LMAPI_API_KEY_FILE=.lmapi_key
# Explicit administrator allowlists; never inferred from client roles.
AI_ADMIN_USER_IDS=
AI_ADMIN_EMAILS=

# Existing specialized media providers, and compatibility when LM API is not configured.
LLM_PROVIDER=arvan
CONTENT_LLM_PROVIDER=arvan
ARVAN_AI_API_KEY=
ARVAN_AI_API_BASE=https://aiapi.rafiei.co/v1
ARVAN_AI_MODEL=GPT-5.6-Sol
AI_TIMEOUT_SECONDS=300

LLM_MODEL=GPT-5.6-Sol
# Fallback model if LLM_MODEL returns empty
LLM_FALLBACK_MODEL=DEEPSEEK_V4_FLASH

# Correction model (long Persian text)
CORRECTION_PROVIDER=arvan
CORRECTION_MODEL=GPT-5.6-Sol

# Vision models (for effect selection and criticism)
VISION_PROVIDER=arvan
VISION_MODEL=GPT-5.6-Sol
EFFECT_MODEL=GPT-5.6-Sol

IMAGE_MODEL=gpt-5-5-image

# Every TTS surface uses Localize's ElevenLabs voice/model and transport.
TTS_PROVIDER=elevenlabs
CONTENT_TTS_PROVIDER=elevenlabs
# Required Vercel relay root for networks where ElevenLabs is blocked.
# Example: https://rafiei-telegram-api-relay.vercel.app/api/elevenlabs
ELEVENLABS_PROXY_URL=
CONTENT_TTS_ELEVENLABS_VOICE_FA=
# Optional language-specific override for English narration.
CONTENT_TTS_ELEVENLABS_VOICE_EN=
CONTENT_VOICE_PROVIDER=elevenlabs

# Local Whisper is optional. If disabled or unavailable, jobs keep going with
# FFmpeg audio extraction and an empty transcript (no captions).
WHISPER_ENABLED=true
WHISPER_MODEL_SIZE=base
# First run also downloads the model, so this must cover download + decode.
WHISPER_TIMEOUT_SECONDS=600
# Deprecated compatibility name; WHISPER_MODEL_SIZE takes precedence.
WHISPER_MODEL=

# Production deployment (replace placeholder values before use)
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql+asyncpg://airender:replace-password@db:5432/airender
POSTGRES_USER=airender
POSTGRES_PASSWORD=replace-password
POSTGRES_DB=airender
REDIS_URL=redis://redis:6379/0
# Celery uses REDIS_URL as broker and backend. Job files use JOBS_DIR below.

# Production web entry point. Exact hostname(s), without scheme or port; separate
# multiple hosts with commas. These values are placeholders and must be replaced.
APP_ENV=production
ALLOWED_HOSTS=example.com
# Leave empty for the same-origin nginx deployment; comma-separated HTTPS origins only if needed.
CORS_ORIGINS=
JOBS_DIR=/app/job_data
ASSETS_DIR=assets
# Readiness reports degraded when either filesystem has less free space than this.
HEALTH_MIN_DISK_FREE_GB=2
PRESETS_DIR=presets
AI_RENDER_FONT_FILES=

# Hermes encrypts stored Instagram credentials with this stable Fernet key.
# Generate once with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Keep the generated value stable and secret; replace this placeholder before deployment.
HERMES_TOKEN_KEY=replace-with-generated-fernet-key
# Encrypts Instagram credentials saved in the Hermes settings UI. Falls back to HERMES_TOKEN_KEY; a random key is generated in development (saved credentials are lost on restart).
HERMES_ENCRYPTION_KEY=replace-with-generated-fernet-key
# Each user enters Instagram App ID, App Secret, Access Token and User ID in the Hermes UI.
INSTAGRAM_REDIRECT_URI=https://example.com/api/hermes/auth/callback
HERMES_PUBLIC_MEDIA_BASE_URL=https://example.com
HERMES_DATA_DIR=/app/jobs/hermes
INSTAGRAM_GRAPH_VERSION=v25.0

# Optional provider/runtime overrides.
# LLM_* takes precedence; OPENAI_* is accepted as a fallback for OpenAI-compatible providers.
LLM_API_KEY=
LLM_BASE_URL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
IMAGE_API_KEY=
OPENAI_BASE_URL=
IMAGE_FALLBACK_MODEL=
HERMES_LLM_MODEL=
ASR_ENGINE=
AI_PROVIDER=arvan
AI_PROVIDER_TIMEOUT_SECONDS=300
AI_CORRECTION_TIMEOUT_SECONDS=45
JWT_ACCESS_HOURS=24
JWT_REFRESH_DAYS=30

# SMTP delivery for password reset emails. Port 587 uses STARTTLS; port 465 uses implicit TLS.
# Leave these empty to disable delivery (the API logs a development reset token and returns 503).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Enable deterministic motion graphics for talking style 2.
TALKING_HYPERFRAMES_ENABLED=false

# All model requests use Arvan; image generation requires a verified image model.
ARVAN_VISION_MODEL=Gemini-3-Flash-Preview
ARVAN_IMAGE_MODEL=Gemini-3.1-Flash-Image-Preview
