# Optional low-disk VPS upgrade; tag the current working runtime :pre-lmapi first.
# Fresh installs use Dockerfile. This file never copies a credential or .env.
FROM node:22-bookworm-slim AS tscaps
WORKDIR /tscaps
COPY tools/tscaps/package*.json ./
# Captions run in Chromium; native Node ONNX binaries are never used here.
RUN npm ci --ignore-scripts --no-audit --no-fund && npm cache clean --force \
    && node -e "require('node:fs').rmSync('node_modules/onnxruntime-node/bin', {recursive:true, force:true})"

FROM ai-render-runtime:pre-lmapi
COPY app/ /app/app/
COPY brain/ /app/brain/
COPY creative/ /app/creative/
COPY engine/ /app/engine/
COPY tools/tscaps/ /app/tools/tscaps/
COPY --from=tscaps /tscaps/node_modules /app/tools/tscaps/node_modules
ENV TSCAPS_CHROME=/usr/bin/chromium
COPY scripts/ /app/scripts/
COPY alembic/ /app/alembic/
COPY alembic.ini request_context.py /app/
